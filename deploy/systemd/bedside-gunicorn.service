[Unit]
Description=Bedside Django app (Gunicorn)
After=network.target

[Service]
Type=simple
User=bedside
Group=bedside
WorkingDirectory=/opt/bedside/backend
RuntimeDirectory=bedside
EnvironmentFile=/opt/bedside/backend/.env
ExecStart=/opt/bedside/backend/venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --timeout 120 \
    --bind unix:/run/bedside/gunicorn.sock
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
