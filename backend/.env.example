SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
# Only whisper-large-v3 supports Groq's /audio/translations endpoint today -
# separate from GROQ_STT_MODEL in case that's set to a transcription-only model.
GROQ_TRANSLATE_MODEL=whisper-large-v3
GROQ_MOCK=1

# Only sent to models that support them (see core/services/groq_client.py's
# REASONING_EFFORT_MODELS / REASONING_FORMAT_MODELS) - safe to leave set even
# if you switch GROQ_CHAT_MODEL to a non-reasoning model.
GROQ_REASONING_EFFORT=low
GROQ_REASONING_FORMAT=hidden

# WeasyPrint (PDF reports) needs Pango/cairo/GObject native libraries that
# aren't installed system-wide on Windows by default. If you installed them
# via MSYS2 without admin rights (see README.md), point WeasyPrint at them
# here instead of editing your system PATH - e.g.:
# WEASYPRINT_DLL_DIRECTORIES=C:\Users\<you>\msys64\ucrt64\bin
# Leave unset on Linux/the Ubuntu deploy target, where the apt packages put
# the libraries somewhere WeasyPrint finds automatically.
WEASYPRINT_DLL_DIRECTORIES=
